PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/crypto_tracker
# live = real CoinGecko API | mock = deterministic offline demo data
COINGECKO_MODE=live
# Optional: free "demo" key from coingecko.com/en/api (higher rate limit)
COINGECKO_API_KEY=
COIN_COUNT=100
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=600
# Seconds each kind of data is served from memory before refetching
TTL_MARKETS=60
TTL_DETAIL=300
TTL_CHART=900
